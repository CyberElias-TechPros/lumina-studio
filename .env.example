# Lumina Studio frontend env vars (all VITE_* are public and bundled).
# Copy to .env and fill in. Leaving VITE_API_URL empty runs the app in MOCK MODE:
# every API call resolves against the mock data in src/data/* (no backend needed).

# Cloudflare Worker API base. Examples:
#   https://api.cea.academy   (production)
#   http://localhost:8787     (wrangler dev)
VITE_API_URL=

# WebSocket base for the realtime layer (chat, live class, presence, notifications).
# Same origin as the API. Phase 5.
VITE_WS_URL=

# Cloudflare Turnstile site key (public widget key).
VITE_TURNSTILE_SITE_KEY=

# Paystack public key (PK key).
VITE_PAYSTACK_PUBLIC_KEY=

# VAPID public key (Web Push) — must match the worker's VAPID_PUBLIC_KEY secret.
VITE_VAPID_PUBLIC_KEY=

# dev | staging | prod — gates analytics flushing, service worker registration, logging.
VITE_APP_ENV=dev
