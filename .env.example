# Next.js browser-exposed settings use NEXT_PUBLIC_. Never put Worker secrets here.
# Copy to .env.local. Leaving NEXT_PUBLIC_API_URL empty uses the offline mock registry.
# Production builds should set an API URL unless mock mode is explicitly intentional.

# Cloudflare Worker API base. Examples:
#   https://cea-api.cyber-e54.workers.dev (production)
#   http://localhost:8787               (wrangler dev)
NEXT_PUBLIC_API_URL=

# Safety valve for intentional demo builds only; keep false/unset for production.
NEXT_PUBLIC_ENABLE_MOCKS=false

# WebSocket base for realtime chat, live class, presence and notifications.
NEXT_PUBLIC_WS_URL=

# Cloudflare Turnstile site key (public widget key).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Paystack public key (PK key).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# VAPID public key (Web Push); must match the Worker's VAPID_PUBLIC_KEY secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# dev | staging | prod — gates analytics flushing, service worker registration and logging.
NEXT_PUBLIC_APP_ENV=dev

# Optional Google Analytics 4 measurement ID. Only initialized after analytics consent.
NEXT_PUBLIC_GA4_ID=
