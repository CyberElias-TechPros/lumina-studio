# Next.js browser-exposed settings use NEXT_PUBLIC_. Never put Worker secrets here.
# Copy to .env.local. Leaving NEXT_PUBLIC_API_URL empty uses the offline mock registry.
# Production builds should set an API URL unless mock mode is explicitly intentional.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Cloudflare Worker API base. Examples:
#   https://cea-api.cyber-e54.workers.dev (production)
#   http://localhost:8787               (wrangler dev)
NEXT_PUBLIC_API_URL=

# Safety valve for intentional demo builds only; keep false/unset for production.
NEXT_PUBLIC_ENABLE_MOCKS=false

# WebSocket base for realtime chat, live class, presence and notifications.
NEXT_PUBLIC_WS_URL=

# Cloudflare Turnstile site key (public widget key).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Paystack public key (PK key).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# VAPID public key (Web Push); must match the Worker's VAPID_PUBLIC_KEY secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# dev | staging | prod — gates service worker registration, logging and the
# environment badge on /status.
NEXT_PUBLIC_APP_ENV=dev

# ---------------------------------------------------------------------------
# Optional third parties
# ---------------------------------------------------------------------------
#
# These are no longer gated behind an env flag. Every one of them is gated on
# the visitor's cookie decision (see src/lib/consent.ts) and refuses to run on
# /app, /portal, /auth, /apply, /pay, /payment, /checkout, /cart, /certificates
# and /contact regardless of consent (see src/lib/tracking.ts).
#
# Leaving a value empty simply means that tool is not loaded at all.

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GA4_ID=

# Microsoft Clarity has a fixed public project id in src/lib/tracking.ts
# (CLARITY_PROJECT_ID). Change it there, not here, so the privacy policy table
# and the loader cannot disagree.

# DEPRECATED: this flag used to gate GA4, AdSense, Clarity and the consent
# banner together. Because it defaulted to false, the ad tag could never load in
# any default deployment and the banner never appeared — so no visitor was ever
# asked, and no ad ever filled. It is retained only so an existing environment
# that sets it does not fail a variable check; nothing reads it any more.
# Remove it from your hosting environment when convenient.
NEXT_PUBLIC_ENABLE_PUBLIC_TRACKING=

# ---------------------------------------------------------------------------
# Build-time expectations
# ---------------------------------------------------------------------------
#
# `scripts/check-production-env.mjs` runs before every production build and
# fails closed if:
#   · NEXT_PUBLIC_API_URL is missing, not https, or carries credentials/path/query
#   · NEXT_PUBLIC_ENABLE_MOCKS is true on Vercel production
#   · NEXT_PUBLIC_APP_ENV is not one of dev | staging | prod
