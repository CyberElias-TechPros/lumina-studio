{
  "name": "cea-android",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync": "npm run firebase:check && npm run offline:build && cap sync android",
    "open": "cap open android",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "typecheck": "tsc --noEmit",
    "offline:build": "node scripts/build-offline.mjs",
    "firebase:check": "node scripts/validate-firebase.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "typescript": "~5.8.3",
    "@types/node": "^22.0.0"
  }
}
