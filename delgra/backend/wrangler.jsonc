{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delgra",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "c567f93a5269d713595b68c75f8f33c5",
  "observability": { "enabled": true },

  "vars": {
    "APP_ENV": "production",
    "FRONTEND_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://delgra.freegameplay.site,https://frontend-phi-one-blilpsvwav.vercel.app",
    "APP_URL": "https://delgra.freegameplay.site/",
    "COOKIE_SECURE": "true",
    "SESSION_TTL_MINUTES": "10080",
    "MAX_UPLOAD_BYTES": "10485760"
  },

  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "f044a32617a44503b55b63ae033ab4e7" }
  ],

  "d1_databases": [
    { "binding": "DB", "database_name": "delgra-db", "database_id": "820bba6c-c457-4bba-a056-55029f59c444", "migrations_dir": "migrations" }
  ],

  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "delgra-uploads" }
  ],

  "triggers": {
    "crons": ["15 6 * * *"]
  }
}
