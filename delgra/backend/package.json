{
  "name": "@delgra/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Delgra Ledger API — Cloudflare Worker (Hono + D1 + R2 + KV)",
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --var COOKIE_SECURE:false",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:clean": "rm -rf .vitest-r2 .wrangler",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:reset:local": "rm -rf .wrangler/state && wrangler d1 migrations apply DB --local",
    "seed:local": "tsx scripts/seed-demo.ts",
    "seed:remote": "tsx scripts/seed-demo.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.12.33",
    "pdf-lib": "^1.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.66",
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/node": "^22.16.5",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.32.0"
  }
}
